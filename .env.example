# ==========================================================
# Print3D Manager ERP - Variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores.
# NUNCA commite o arquivo .env real.
# ==========================================================

# ----- PostgreSQL -----
POSTGRES_DB=print3d_manager
POSTGRES_USER=print3d
# OBRIGATÓRIO: docker-compose.yml não tem mais default para esta variável
# (achado ALTO da auditoria de 2026-08-16 — "print3d" era previsível e
# valia mesmo sem .env). Sem ela definida, `docker compose up`/`config`
# falha explicitamente (fail-fast) em vez de subir com senha fraca.
POSTGRES_PASSWORD=troque-esta-senha

# ----- Backend -----
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://postgres:5432/print3d_manager
DATABASE_USERNAME=print3d
# Mesmo valor de POSTGRES_PASSWORD acima (o backend conecta no mesmo banco).
DATABASE_PASSWORD=troque-esta-senha

# Segredo JWT: string Base64 de no mínimo 256 bits (32 bytes).
# Gere um novo com: openssl rand -base64 48
# OBRIGATÓRIO: docker-compose.yml não tem mais default para esta variável
# (o antigo default ficava sempre presente e mascarava qualquer validação
# fail-fast do backend em application-prod.yml). Sem ela definida,
# `docker compose up`/`config` falha explicitamente.
JWT_SECRET=troque-por-um-segredo-base64-de-48-bytes
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost

# ----- Uploads (STL/3MF, fotos) -----
UPLOAD_DIR=/app/uploads

# ----- Rate limit (requisições por IP por janela nas rotas abertas) -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_JANELA_SEGUNDOS=60

# ----- Proxy confiável (RemoteIpValve) -----
# Regex do IP FIXO do container "frontend" (NGINX) na rede print3d-network
# (ver docker-compose.yml: networks.print3d-network.ipam + frontend.networks.
# ipv4_address) — só esse peer exato tem o X-Forwarded-For aceito como IP
# real do cliente. Propositalmente NÃO cobre a sub-rede inteira: o gateway
# da rede (ex.: 172.28.5.1) é usado pelo Docker para NAT de conexões
# publicadas no host e, se fosse "confiável", permitiria forjar o X-
# Forwarded-For a partir de fora (bypass de rate limit). Se mudar o IP fixo
# do frontend no compose, atualize este regex também.
TOMCAT_INTERNAL_PROXIES=172\.28\.5\.10
